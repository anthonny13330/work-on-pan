rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── PERFIS DE UTILIZADOR ──────────────────────────────────
    // Leitura pública (para mostrar nomes/tipo em listagens e no chat).
    // Escrita só pelo próprio dono da conta.
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // ── PROJETOS ───────────────────────────────────────────────
    // Leitura pública. Só o cliente dono pode criar/editar/apagar os seus.
    match /projetos/{projetoId} {
      allow read: if true;
      allow create: if request.auth != null
                     && request.auth.uid == request.resource.data.clienteId;
      allow update, delete: if request.auth != null
                     && request.auth.uid == resource.data.clienteId;
    }

    // ── PROPOSTAS ──────────────────────────────────────────────
    // Só o freelancer que a enviou e o cliente do projeto a podem ver/alterar.
    match /propostas/{propostaId} {
      allow read: if request.auth != null &&
                    (request.auth.uid == resource.data.freelancerId ||
                     request.auth.uid == resource.data.clienteId);
      allow create: if request.auth != null
                     && request.auth.uid == request.resource.data.freelancerId;
      allow update: if request.auth != null &&
                    (request.auth.uid == resource.data.freelancerId ||
                     request.auth.uid == resource.data.clienteId);
      allow delete: if false;
    }

    // ── CONVERSAS (CHAT) ───────────────────────────────────────
    // Só quem está na lista "participantes" pode ler/escrever a conversa e as mensagens.
    match /chats/{chatId} {
      allow read, update: if request.auth != null
                     && request.auth.uid in resource.data.participantes;
      allow create: if request.auth != null
                     && request.auth.uid in request.resource.data.participantes;
      allow delete: if false;

      match /mensagens/{msgId} {
        allow read, create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantes;
        allow update, delete: if false;
      }
    }
  }
}
