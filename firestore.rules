rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }
    function souEu(uid) {
      return autenticado() && request.auth.uid == uid;
    }
    function tipoDe(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.tipo;
    }
    function soAltera(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }
    function textoValido(valor, maximo) {
      return valor is string && valor.size() > 0 && valor.size() <= maximo;
    }

    // ── CONTA (privado) ──────────────────────────────────────────
    // E-mail, telefone, consentimento RGPD. Só o próprio lê e escreve.
    // O tipo (cliente/freelancer) é escolhido no registo e não muda.
    match /users/{uid} {
      allow read, delete: if souEu(uid);
      allow create: if souEu(uid)
                    && request.resource.data.tipo in ['cliente', 'freelancer'];
      allow update: if souEu(uid)
                    && request.resource.data.tipo == resource.data.tipo;
    }

    // ── PERFIL PÚBLICO ───────────────────────────────────────────
    // Nome, área, bio, competências. Visível para toda a gente.
    match /perfis/{uid} {
      allow read: if true;
      allow create, update: if souEu(uid)
                            && request.resource.data.tipo == tipoDe(uid);
      allow delete: if souEu(uid);
    }

    // ── PROJETOS ─────────────────────────────────────────────────
    // Estados: aberto → em_andamento → concluido  (ou fechado pelo cliente)
    match /projetos/{projetoId} {
      allow read: if true;
      allow create: if autenticado()
                    && request.resource.data.clienteId == request.auth.uid
                    && tipoDe(request.auth.uid) == 'cliente'
                    && request.resource.data.estado == 'aberto'
                    && textoValido(request.resource.data.titulo, 120)
                    && textoValido(request.resource.data.descricao, 4000);
      allow update: if autenticado()
                    && resource.data.clienteId == request.auth.uid
                    && request.resource.data.clienteId == resource.data.clienteId
                    && request.resource.data.estado in ['aberto', 'em_andamento', 'concluido', 'fechado'];
      allow delete: if autenticado() && resource.data.clienteId == request.auth.uid;
    }

    // ── PROPOSTAS ────────────────────────────────────────────────
    // Id fixo "<projetoId>_<freelancerId>": uma proposta por freelancer e projeto.
    // Freelancer: cria, edita ou retira enquanto está pendente.
    // Cliente: aceita, recusa ou fecha.
    match /propostas/{propostaId} {
      function projeto(pid) {
        return get(/databases/$(database)/documents/projetos/$(pid)).data;
      }

      allow read: if autenticado()
                  && (request.auth.uid == resource.data.freelancerId
                      || request.auth.uid == resource.data.clienteId);

      allow create: if autenticado()
                    && request.resource.data.freelancerId == request.auth.uid
                    && propostaId == request.resource.data.projetoId + '_' + request.auth.uid
                    && tipoDe(request.auth.uid) == 'freelancer'
                    && request.resource.data.estado == 'pendente'
                    && projeto(request.resource.data.projetoId).estado == 'aberto'
                    && projeto(request.resource.data.projetoId).clienteId == request.resource.data.clienteId
                    && textoValido(request.resource.data.mensagem, 3000);

      allow update: if autenticado() && (
          (request.auth.uid == resource.data.clienteId
            && soAltera(['estado', 'atualizadoEm'])
            && request.resource.data.estado in ['aceite', 'recusada', 'fechada'])
        ||
          (request.auth.uid == resource.data.freelancerId
            && resource.data.estado in ['pendente', 'retirada']
            && request.resource.data.estado in ['pendente', 'retirada']
            && soAltera(['estado', 'valor', 'moeda', 'prazoEntrega', 'mensagem', 'atualizadoEm']))
      );
      allow delete: if false;
    }

    // ── CONVERSAS ────────────────────────────────────────────────
    // Id fixo: "p_<projetoId>_<freelancerId>" (sobre um projeto)
    //          "d_<uidA>_<uidB>"             (contacto direto, uids ordenados)
    match /chats/{chatId} {
      // resource == null permite verificar se a conversa já existe antes de a criar.
      allow read: if autenticado()
                  && (resource == null || request.auth.uid in resource.data.participantes);
      allow create: if autenticado()
                    && request.auth.uid in request.resource.data.participantes
                    && request.resource.data.participantes.size() == 2;
      allow update: if autenticado()
                    && request.auth.uid in resource.data.participantes
                    && request.resource.data.participantes == resource.data.participantes;
      allow delete: if false;

      match /mensagens/{msgId} {
        function participantes() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.participantes;
        }
        allow read: if autenticado() && request.auth.uid in participantes();
        allow create: if autenticado()
                      && request.auth.uid in participantes()
                      && request.resource.data.autor in [request.auth.uid, 'sistema']
                      && textoValido(request.resource.data.texto, 4000);
        allow update, delete: if false;
      }
    }
  }
}
